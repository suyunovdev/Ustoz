# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL — Prisma 7 + pg adapter
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ustoz_db"

# ─── Auth ──────────────────────────────────────────────────────────────────
# JWT secret — 32+ tasodifiy belgi
# Generate: openssl rand -base64 48
JWT_SECRET="your-super-secret-jwt-key-here"

# ─── Public URLs ───────────────────────────────────────────────────────────
# Frontend uchun (auth callback, sharing va h.k.)
NEXT_PUBLIC_APP_URL=http://localhost:4028
# SEO uchun — sitemap.xml va robots.txt'da ishlatiladi
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# ─── Cloudflare R2 (fayl/material saqlash) — ixtiyoriy ─────────────────────
# Sozlanmasa: kichik fayllar base64 (dev), yuklash cheklangan.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Ixtiyoriy public CDN prefiks, masalan https://cdn.ustozedu.uz
R2_PUBLIC_URL=

# ─── Bunny Stream (himoyalangan dars videolari) — ixtiyoriy ────────────────
# Video Library (bunny.net → Stream → Video Libraries) yarating.
# LIBRARY_ID + API_KEY — video yaratish/o'chirish + TUS yuklash imzosi + embed token.
# TOKEN_KEY — (ixtiyoriy) embed "Token Authentication" kaliti; berilmasa API_KEY ishlatiladi.
# Kutubxonada "Token Authentication" + "Allowed Referrers" (ustozedu.uz) yoqilsin;
# ekranga qarshi kuchli himoya kerak bo'lsa MediaCage DRM'ni Bunny panelidan yoqing.
# Sozlanmasa: /api/upload/bunny va stream-token 503 beradi, YouTube/Vimeo ishlaydi.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=

# ─── Payment (Click & Payme) ───────────────────────────────────────────────
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=

# ─── Email (Gmail SMTP) ────────────────────────────────────────────────────
# Gmail akkaunt + App Password (2FA yoqilgan bo'lishi kerak)
# App Password: myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Email (Resend) — ixtiyoriy ────────────────────────────────────────────
RESEND_API_KEY=

# ─── AI (ixtiyoriy) ────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Monitoring (ixtiyoriy) ────────────────────────────────────────────────
# Sentry — error tracking
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Obunachi kurs chegirmasi (foizda, 0-100). all-access reja bo'lsa 100=bepul.
SUBSCRIBER_COURSE_DISCOUNT_PCT=30
